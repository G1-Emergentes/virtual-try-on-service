# Copia este archivo como .env y pega tu token de Hugging Face
HF_TOKEN=hf_tu_token_aqui

# Resolución de la textura (512 usa menos VRAM)
TEXTURE_RESOLUTION=1024

# Clave de Google Gemini (Google AI Studio). Valida las fotos y detecta la categoría.
GEMINI_API_KEY=tu_clave_aqui
# Modelo opcional (por defecto gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Modelo de reconstrucción: spar3d (por defecto) o sf3d. Al cambiarlo: docker compose up --build
RECON_MODEL=spar3d
# SPAR3D en modo de bajo consumo (~7 GB de VRAM). Necesario con GPU de 8 GB.
SPAR3D_LOW_VRAM=1

# --- Conexión con el Digital Closet Service ---
# URL base de su API. Desde Docker, el Digital Closet que corre en Windows se alcanza así:
# DC_API_URL=http://host.docker.internal:8081/api/v1
# Vacía = MODO LOCAL: no se verifica la prenda y la foto se envía en la petición.
DC_API_URL=
# Segundos de espera al Digital Closet
# DC_TIMEOUT_S=15

# Categorías que ya se pueden probar en RA (etiqueta AR_READY). Las demás salen como MODEL_3D.
# AR_CATEGORIES=glasses
# Ajuste en la cara por defecto de los lentes (JSON). Vacío = valores del servicio.
# AR_FIT_GLASSES={"offset_m": [0, 0.003, 0.006], "scale": 1.0, "pitch_deg": 0}

# --- Rutas (para el API Gateway) ---
# Prefijo de todas las rutas. El gateway enruta /api/v1/try-on/* a este servicio.
# API_PREFIX=/api/v1/try-on
# Ruta con la que la app ve el servicio (se usa en model_url y thumbnail_url). Por defecto = API_PREFIX.
# PUBLIC_BASE_PATH=/api/v1/try-on

# --- Seguridad ---
# Clave para el diagnóstico interno GET /health/details (header X-Diagnostics-Key). Vacía = desactivado.
# DIAGNOSTICS_KEY=
# Swagger visible (/docs). En producción: false
# EXPOSE_DOCS=true
# Origen interno de Supabase si la URL firmada del armario apunta a loopback
# y Virtual Try-On corre en Docker. Ejemplo: http://host.docker.internal:54321
DC_STORAGE_INTERNAL_URL=

# Proyecto Supabase dedicado a los modelos (opcional, requiere DC_API_URL).
# Usa la URL HTTPS del proyecto y configura su clave secreta solo en el servidor.
MODEL_STORAGE_URL=
MODEL_STORAGE_KEY=
